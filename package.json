{
  "name": "conversor-letras-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test scripts/test-fonts.mjs scripts/test-browser-data.mjs scripts/test-tools.mjs scripts/test-diagnostics.mjs",
    "build": "vite build && node scripts/generate-sitemap.js dist && vite build --ssr entry-server.tsx --outDir .ssr && node scripts/prerender.mjs && node scripts/finalize-build.mjs",
    "preview": "node scripts/preview-pages.mjs",
    "sitemap": "node scripts/generate-sitemap.js public",
    "typecheck": "tsc --noEmit",
    "check:pages": "node scripts/check-pages.mjs",
    "check:http": "node scripts/check-http.mjs --local",
    "check:deployment": "node scripts/check-http.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.4",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "@types/node": "^24.19.1",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "terser": "^5.51.2",
    "typescript": "^5.2.2",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-build": "^7.4.1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  }
}
